{% assign custom_fields = trmnl.plugin_settings.custom_fields_values %}
{% assign view_size = size | default: "full" %}
{% assign hide_title_bar = custom_fields.hide_title_bar | default: config.hide_title_bar | default: "no" | downcase %}
{% assign location_name = custom_fields.location_name | default: config.location_name | default: "" | strip %}
{% assign forecast_interval = custom_fields.forecast_interval | default: config.forecast_interval | default: "daily" %}
{% assign current_time_format = custom_fields.time_format | default: config.time_format | default: "%I:%M %p" %}
{% assign hourly_time_format = custom_fields.hourly_time_format | default: config.hourly_time_format | default: "%I %p" %}
{% assign date_format = custom_fields.date_format | default: config.date_format | default: "%a %d" %}
{% assign current_time_format = current_time_format | replace: "%-I", "%I" | replace: "%-H", "%H" | replace: "%-M", "%M" | replace: "%-S", "%S" %}
{% assign hourly_time_format = hourly_time_format | replace: "%-I", "%I" | replace: "%-H", "%H" | replace: "%-M", "%M" | replace: "%-S", "%S" %}
{% assign date_format = date_format | replace: "%-d", "%d" | replace: "%-m", "%m" %}
{% assign pill_count_setting = custom_fields.pill_count_override | default: config.pill_count_override | default: "automatic" %}
{% assign pill_count = 7 %}
{% if pill_count_setting != "automatic" %}
  {% assign pill_count = pill_count_setting | plus: 0 %}
{% endif %}
{% if pill_count < 3 %}
  {% assign pill_count = 3 %}
{% endif %}
{% if pill_count > 7 %}
  {% assign pill_count = 7 %}
{% endif %}

{% assign temp_unit_symbol = data.current_units.temperature_2m | default: "°" %}
{% assign degree_symbol = temp_unit_symbol | slice: 0, 1 | default: "°" %}
{% assign current_temp = data.current.temperature_2m | round %}
{% assign current_code = data.current.weather_code | plus: 0 %}
{% assign current_condition = "Clear" %}
{% if current_code == 1 %}
  {% assign current_condition = "Mostly clear" %}
{% elsif current_code == 2 %}
  {% assign current_condition = "Partly cloudy" %}
{% elsif current_code == 3 %}
  {% assign current_condition = "Cloudy" %}
{% elsif current_code == 45 or current_code == 48 %}
  {% assign current_condition = "Fog" %}
{% elsif current_code >= 51 and current_code <= 67 %}
  {% assign current_condition = "Rain" %}
{% elsif current_code >= 71 and current_code <= 77 %}
  {% assign current_condition = "Snow" %}
{% elsif current_code >= 80 and current_code <= 82 %}
  {% assign current_condition = "Showers" %}
{% elsif current_code >= 95 %}
  {% assign current_condition = "Storm" %}
{% endif %}

{% assign has_weather = false %}
{% if data.current.temperature_2m and data.current.time %}
  {% assign has_weather = true %}
{% endif %}

{% assign hourly_start_index = 0 %}
{% assign current_epoch = data.current.time | date: "%s" | plus: 0 %}
{% for i in (0..167) %}
  {% assign slot_epoch = data.hourly.time[i] | date: "%s" | plus: 0 %}
  {% if hourly_start_index == 0 and slot_epoch >= current_epoch %}
    {% assign hourly_start_index = i %}
  {% endif %}
{% endfor %}

{% assign hour_step = 1 %}
{% unless forecast_interval == "daily" %}
  {% assign hour_step = forecast_interval | plus: 0 %}
  {% if hour_step < 1 %}
    {% assign hour_step = 1 %}
  {% endif %}
{% endunless %}

{% assign forecast_min = 9999 %}
{% assign forecast_max = -9999 %}
{% if forecast_interval == "daily" %}
  {% for i in (0..6) %}
    {% assign slot_number = i | plus: 1 %}
    {% if slot_number <= pill_count %}
      {% assign point_high = data.daily.temperature_2m_max[i] | round %}
      {% assign point_low = data.daily.temperature_2m_min[i] | round %}
      {% if point_high > forecast_max %}
        {% assign forecast_max = point_high %}
      {% endif %}
      {% if point_low < forecast_min %}
        {% assign forecast_min = point_low %}
      {% endif %}
    {% endif %}
  {% endfor %}
{% else %}
  {% for i in (0..6) %}
    {% assign slot_number = i | plus: 1 %}
    {% if slot_number <= pill_count %}
      {% assign hour_offset = i | times: hour_step %}
      {% assign point_index = hourly_start_index | plus: hour_offset %}
      {% assign point_temp = data.hourly.temperature_2m[point_index] | round %}
      {% if point_temp > forecast_max %}
        {% assign forecast_max = point_temp %}
      {% endif %}
      {% if point_temp < forecast_min %}
        {% assign forecast_min = point_temp %}
      {% endif %}
    {% endif %}
  {% endfor %}
{% endif %}
{% assign forecast_span = forecast_max | minus: forecast_min %}
{% if forecast_span < 1 %}
  {% assign forecast_span = 1 %}
{% endif %}

<div class="view view--{{ view_size }}">
<style>
  .wxg {
    --wxg-dot: rgba(0, 0, 0, 0.64);
    --wxg-dot-soft: rgba(0, 0, 0, 0.46);
    --wxg-ink: #111;
    --wxg-muted: #565656;
    color: var(--wxg-ink);
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    justify-content: center;
    min-height: 100%;
    overflow: hidden;
    width: 100%;
  }

  .wxg__content {
    align-items: end;
    display: grid;
    gap: 20px;
    grid-template-columns: 188px minmax(0, 1fr);
    height: 372px;
    padding: 18px 52px 0;
  }

  .wxg__current {
    align-self: center;
    justify-self: center;
    margin-bottom: 0;
    text-align: center;
    transform: translateX(-28px);
  }


  .wxg__temp {
    font-size: 76px;
    font-weight: 400;
    letter-spacing: -0.08em;
    line-height: 0.88;
    text-align: center;
  }


  .wxg__forecast {
    align-items: start;
    display: grid;
    gap: 14px;
    grid-template-columns: repeat({{ pill_count }}, minmax(0, 1fr));
    height: 360px;
    min-width: 0;
  }

  .wxg__point {
    align-items: center;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .wxg__date {
    font-size: 16px;
    font-weight: 900;
    line-height: 1;
    margin-bottom: 12px;
    min-height: 16px;
    text-align: center;
    white-space: nowrap;
  }

  .wxg__slot {
    height: 318px;
    width: 58px;
  }

  .wxg__pill {
    align-items: center;
    background-color: #efefef;
    background-image: radial-gradient(var(--wxg-dot-soft) 0.85px, transparent 0.95px);
    background-size: 3px 3px;
    border-radius: 999px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 132px;
    overflow: hidden;
    padding: 13px 6px 14px;
    width: 58px;
  }

  .wxg__pill--cloud {
    background-color: #e3e3e3;
    background-image: radial-gradient(var(--wxg-dot) 0.85px, transparent 0.95px);
  }

  .wxg__pill--rain,
  .wxg__pill--storm {
    background-color: #d2d2d2;
    background-image: radial-gradient(rgba(0, 0, 0, 0.76) 0.9px, transparent 1px);
  }

  .wxg__icon {
    color: var(--wxg-ink);
    height: 34px;
    margin-bottom: 2px;
    width: 42px;
  }

  .wxg__icon path,
  .wxg__icon circle,
  .wxg__icon line {
    vector-effect: non-scaling-stroke;
  }

  .wxg__icon--clear .wxg__cloud,
  .wxg__icon--clear .wxg__rain,
  .wxg__icon--clear .wxg__bolt,
  .wxg__icon--cloud .wxg__sun,
  .wxg__icon--cloud .wxg__rain,
  .wxg__icon--cloud .wxg__bolt,
  .wxg__icon--rain .wxg__sun,
  .wxg__icon--rain .wxg__bolt,
  .wxg__icon--storm .wxg__sun {
    display: none;
  }

  .wxg__value {
    font-size: 22px;
    font-weight: 900;
    line-height: 1;
  }

  .wxg__value--low {
    margin-top: auto;
  }

  .wxg__condition {
    color: var(--wxg-muted);
    font-size: 12px;
    font-weight: 800;
    line-height: 1;
    margin-top: 8px;
  }

  .wxg__error {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    justify-content: center;
    text-align: center;
    width: 100%;
  }

  .wxg__title_bar {
    align-items: center;
    background-color: #eeeeee;
    background-image: radial-gradient(rgba(0, 0, 0, 0.72) 0.85px, transparent 0.95px);
    background-size: 3px 3px;
    border-radius: 999px;
    box-sizing: border-box;
    display: flex;
    font-size: 16px;
    font-weight: 900;
    height: 34px;
    justify-content: space-between;
    line-height: 1;
    margin: 0 10px;
    padding: 0 20px 0 12px;
  }

  .wxg__title {
    align-items: center;
    display: inline-flex;
    gap: 10px;
  }

  .wxg__title-icon {
    height: 24px;
    width: 26px;
  }

  .screen--lg .wxg__content {
    gap: 24px;
    grid-template-columns: 205px minmax(0, 1fr);
    padding-left: 70px;
    padding-right: 70px;
  }

  .screen--portrait .wxg__content {
    gap: 14px;
    grid-template-columns: 1fr;
    height: 690px;
    padding: 12px 16px 0;
  }

  .screen--portrait .wxg__current {
    align-self: center;
    margin-bottom: 0;
    transform: none;
  }

  .screen--portrait .wxg__forecast {
    gap: 8px;
    height: 470px;
  }

  .screen--portrait .wxg__slot {
    height: 420px;
    width: 52px;
  }

  .screen--portrait .wxg__pill {
    width: 52px;
  }

  .screen--portrait .wxg__date {
    font-size: 13px;
  }
</style>

<div class="wxg">
  {% if has_weather %}
    <div class="wxg__content">
      <section class="wxg__current" aria-label="{{ current_condition }}">
        <div class="wxg__temp">{{ current_temp }}{{ degree_symbol }}</div>
      </section>

      <section class="wxg__forecast">
        {% if forecast_interval == "daily" %}
          {% for i in (0..6) %}
            {% assign slot_number = i | plus: 1 %}
            {% if slot_number <= pill_count %}
              {% assign point_time = data.daily.time[i] %}
              {% assign point_code = data.daily.weather_code[i] | plus: 0 %}
              {% assign point_high = data.daily.temperature_2m_max[i] | round %}
              {% assign point_low = data.daily.temperature_2m_min[i] | round %}
              {% assign point_range = point_high | minus: point_low %}
              {% assign point_top_delta = forecast_max | minus: point_high %}
              {% assign bar_height = point_range | times: 145 | divided_by: forecast_span | plus: 128 | round %}
              {% assign bar_top = point_top_delta | times: 145 | divided_by: forecast_span | plus: 4 | round %}
              {% assign pill_class = "wxg__pill" %}
              {% assign icon_class = "wxg__icon wxg__icon--clear" %}
              {% if point_code == 2 or point_code == 3 or point_code == 45 or point_code == 48 %}
                {% assign pill_class = "wxg__pill wxg__pill--cloud" %}
                {% assign icon_class = "wxg__icon wxg__icon--cloud" %}
              {% elsif point_code >= 51 and point_code <= 82 %}
                {% assign pill_class = "wxg__pill wxg__pill--rain" %}
                {% assign icon_class = "wxg__icon wxg__icon--rain" %}
              {% elsif point_code >= 95 %}
                {% assign pill_class = "wxg__pill wxg__pill--storm" %}
                {% assign icon_class = "wxg__icon wxg__icon--storm" %}
              {% endif %}

              {% assign point_label_time = point_time | append: "T12:00" %}
              {% assign point_label = point_label_time | date: date_format | replace: " 0", " " %}
              <article class="wxg__point">
                <div class="wxg__date">{{ point_label }}</div>
                <div class="wxg__slot">
                  <div class="{{ pill_class }}" style="height: {{ bar_height }}px; margin-top: {{ bar_top }}px;">
                    <svg class="{{ icon_class }}" viewBox="0 0 64 48" aria-hidden="true">
                      <circle class="wxg__sun" cx="24" cy="17" r="9" fill="none" stroke="currentColor" stroke-width="4"/>
                      <path class="wxg__sun" d="M24 2v7M24 25v7M9 17h7M32 17h7M13 6l5 5M35 6l-5 5M13 28l5-5M35 28l-5-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="3"/>
                      <path class="wxg__cloud" d="M18 34h28c6 0 10-4 10-9s-4-9-10-9c-2 0-4 1-6 2-2-6-7-10-14-10-8 0-14 6-15 14-5 1-8 4-8 8 0 5 4 4 15 4Z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="4"/>
                      <path class="wxg__rain" d="M20 40l-3 5M33 40l-3 5M46 40l-3 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="4"/>
                      <path class="wxg__bolt" d="M35 31l-8 11h8l-5 7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="4"/>
                    </svg>
                    <div class="wxg__value">{{ point_high }}</div>
                    <div class="wxg__value wxg__value--low">{{ point_low }}</div>
                  </div>
                </div>
              </article>
            {% endif %}
          {% endfor %}
        {% else %}
          {% for i in (0..6) %}
            {% assign slot_number = i | plus: 1 %}
            {% if slot_number <= pill_count %}
              {% assign hour_offset = i | times: hour_step %}
              {% assign point_index = hourly_start_index | plus: hour_offset %}
              {% assign point_time = data.hourly.time[point_index] %}
              {% assign point_code = data.hourly.weather_code[point_index] | plus: 0 %}
              {% assign point_temp = data.hourly.temperature_2m[point_index] | round %}
              {% assign point_top_delta = forecast_max | minus: point_temp %}
              {% assign bar_height = 172 %}
              {% assign bar_top = point_top_delta | times: 145 | divided_by: forecast_span | plus: 34 | round %}
              {% assign pill_class = "wxg__pill" %}
              {% assign icon_class = "wxg__icon wxg__icon--clear" %}
              {% assign point_condition = "Clear" %}
              {% if point_code == 2 or point_code == 3 or point_code == 45 or point_code == 48 %}
                {% assign pill_class = "wxg__pill wxg__pill--cloud" %}
                {% assign icon_class = "wxg__icon wxg__icon--cloud" %}
                {% assign point_condition = "Clouds" %}
              {% elsif point_code >= 51 and point_code <= 82 %}
                {% assign pill_class = "wxg__pill wxg__pill--rain" %}
                {% assign icon_class = "wxg__icon wxg__icon--rain" %}
                {% assign point_condition = "Rain" %}
              {% elsif point_code >= 95 %}
                {% assign pill_class = "wxg__pill wxg__pill--storm" %}
                {% assign icon_class = "wxg__icon wxg__icon--storm" %}
                {% assign point_condition = "Storm" %}
              {% endif %}

              {% assign point_label = point_time | date: hourly_time_format %}
              {% assign point_label_first = point_label | slice: 0, 1 %}
              {% if point_label_first == "0" %}
                {% assign point_label = point_label | slice: 1, 99 %}
              {% endif %}
              <article class="wxg__point">
                <div class="wxg__date">{{ point_label }}</div>
                <div class="wxg__slot">
                  <div class="{{ pill_class }}" style="height: {{ bar_height }}px; margin-top: {{ bar_top }}px;">
                    <svg class="{{ icon_class }}" viewBox="0 0 64 48" aria-hidden="true">
                      <circle class="wxg__sun" cx="24" cy="17" r="9" fill="none" stroke="currentColor" stroke-width="4"/>
                      <path class="wxg__sun" d="M24 2v7M24 25v7M9 17h7M32 17h7M13 6l5 5M35 6l-5 5M13 28l5-5M35 28l-5-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="3"/>
                      <path class="wxg__cloud" d="M18 34h28c6 0 10-4 10-9s-4-9-10-9c-2 0-4 1-6 2-2-6-7-10-14-10-8 0-14 6-15 14-5 1-8 4-8 8 0 5 4 4 15 4Z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="4"/>
                      <path class="wxg__rain" d="M20 40l-3 5M33 40l-3 5M46 40l-3 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="4"/>
                      <path class="wxg__bolt" d="M35 31l-8 11h8l-5 7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="4"/>
                    </svg>
                    <div class="wxg__value">{{ point_temp }}</div>
                    <div class="wxg__condition">{{ point_condition }}</div>
                  </div>
                </div>
              </article>
            {% endif %}
          {% endfor %}
        {% endif %}
      </section>
    </div>
  {% else %}
    <div class="wxg__error">
      <span class="value value--large">Weather unavailable</span>
      <span class="label">Open-Meteo did not return current conditions.</span>
    </div>
  {% endif %}

  {% if hide_title_bar != "yes" %}
    <div class="title_bar wxg__title_bar">
      <span class="wxg__title">
        <svg class="wxg__title-icon" viewBox="0 0 64 48" aria-hidden="true">
          <path d="M18 34h28c6 0 10-4 10-9s-4-9-10-9c-2 0-4 1-6 2-2-6-7-10-14-10-8 0-14 6-15 14-5 1-8 4-8 8 0 5 4 4 15 4Z" fill="currentColor"/>
        </svg>
        <span>Weather Glance</span>
      </span>
      <span>{{ location_name | default: data.timezone | default: "Open-Meteo" }}</span>
    </div>
  {% endif %}
</div>
</div>
