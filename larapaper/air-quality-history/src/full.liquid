{% assign current_aqi = 0 %}
{% assign current_available = false %}
{% assign category = "Unavailable" %}
{% if data.current.us_aqi != nil and data.current.us_aqi != blank %}
  {% assign current_aqi = data.current.us_aqi | plus: 0 %}
  {% if current_aqi >= 0 %}
    {% assign current_available = true %}
  {% if current_aqi <= 50 %}
    {% assign category = "Good" %}
  {% elsif current_aqi <= 100 %}
    {% assign category = "Moderate" %}
  {% elsif current_aqi <= 150 %}
    {% assign category = "Unhealthy for sensitive groups" %}
  {% elsif current_aqi <= 200 %}
    {% assign category = "Unhealthy" %}
  {% elsif current_aqi <= 300 %}
    {% assign category = "Very unhealthy" %}
  {% else %}
    {% assign category = "Hazardous" %}
    {% endif %}
  {% endif %}
{% endif %}

{% assign today_date = data.current.time | slice: 0, 10 %}
{% assign daily_records_text = "" %}
{% assign current_day = "" %}
{% assign day_max = -1 %}
{% assign hourly_last = data.hourly.time.size | minus: 1 %}
{% if hourly_last >= 0 %}
  {% for i in (0..hourly_last) %}
    {% assign day = data.hourly.time[i] | slice: 0, 10 %}
    {% if day != current_day %}
      {% if current_day != "" %}
        {% capture daily_record %}{{ current_day }},{{ day_max }}|{% endcapture %}
        {% assign daily_records_text = daily_records_text | append: daily_record %}
      {% endif %}
      {% assign current_day = day %}
      {% assign day_max = -1 %}
    {% endif %}
    {% assign hourly_value = data.hourly.us_aqi[i] %}
    {% if hourly_value != nil and hourly_value != blank %}
      {% assign numeric_hourly_value = hourly_value | plus: 0 %}
      {% if hourly_value == numeric_hourly_value and numeric_hourly_value >= 0 and numeric_hourly_value > day_max %}
        {% assign day_max = numeric_hourly_value %}
      {% endif %}
    {% endif %}
  {% endfor %}
  {% if current_day != "" %}
    {% capture daily_record %}{{ current_day }},{{ day_max }}|{% endcapture %}
    {% assign daily_records_text = daily_records_text | append: daily_record %}
  {% endif %}
{% endif %}

{% assign daily_records = daily_records_text | split: "|" %}
{% assign daily_count = daily_records.size | minus: 1 %}
{% assign today_index = daily_count %}
{% for record in daily_records %}
  {% assign fields = record | split: "," %}
  {% if fields[0] == today_date %}
    {% assign today_index = forloop.index0 %}
    {% break %}
  {% endif %}
{% endfor %}

{% assign chart_min = 9999 %}
{% assign chart_max = -1 %}
{% assign has_series = false %}
{% assign history_segment = today_index | divided_by: 3 %}
{% if history_segment < 1 %}{% assign history_segment = 1 %}{% endif %}
{% assign segment_three_start = history_segment | times: 2 %}
{% assign history_half = today_index | divided_by: 2 %}
{% if history_half < 1 %}{% assign history_half = 1 %}{% endif %}
{% assign peak_one_value = -1 %}
{% assign peak_two_value = -1 %}
{% assign peak_three_value = -1 %}
{% assign peak_one_index = 0 %}
{% assign peak_two_index = history_segment %}
{% assign peak_three_index = segment_three_start %}
{% assign peak_one_date = "" %}
{% assign peak_two_date = "" %}
{% assign peak_three_date = "" %}
{% assign valley_one_value = 9999 %}
{% assign valley_two_value = 9999 %}
{% assign valley_one_index = 0 %}
{% assign valley_two_index = history_half %}
{% assign valley_one_date = "" %}
{% assign valley_two_date = "" %}

{% for record in daily_records %}
  {% assign fields = record | split: "," %}
  {% if fields[1] != nil and fields[1] != blank %}
    {% assign daily_value = fields[1] | plus: 0 %}
    {% if daily_value >= 0 %}
      {% assign has_series = true %}
      {% if daily_value < chart_min %}{% assign chart_min = daily_value %}{% endif %}
      {% if daily_value > chart_max %}{% assign chart_max = daily_value %}{% endif %}
      {% if forloop.index0 < today_index %}
        {% if forloop.index0 < history_segment %}
          {% if daily_value > peak_one_value %}
            {% assign peak_one_value = daily_value %}
            {% assign peak_one_index = forloop.index0 %}
            {% assign peak_one_date = fields[0] %}
          {% endif %}
        {% elsif forloop.index0 < segment_three_start %}
          {% if daily_value > peak_two_value %}
            {% assign peak_two_value = daily_value %}
            {% assign peak_two_index = forloop.index0 %}
            {% assign peak_two_date = fields[0] %}
          {% endif %}
        {% elsif daily_value > peak_three_value %}
          {% assign peak_three_value = daily_value %}
          {% assign peak_three_index = forloop.index0 %}
          {% assign peak_three_date = fields[0] %}
        {% endif %}
        {% if forloop.index0 < history_half %}
          {% if daily_value < valley_one_value %}
            {% assign valley_one_value = daily_value %}
            {% assign valley_one_index = forloop.index0 %}
            {% assign valley_one_date = fields[0] %}
          {% endif %}
        {% elsif daily_value < valley_two_value %}
          {% assign valley_two_value = daily_value %}
          {% assign valley_two_index = forloop.index0 %}
          {% assign valley_two_date = fields[0] %}
        {% endif %}
      {% endif %}
    {% endif %}
  {% endif %}
{% endfor %}

{% assign chart_span = chart_max | minus: chart_min %}
{% if chart_span < 1 %}{% assign chart_span = 1 %}{% endif %}
{% assign history_count = today_index %}
{% assign history_last_index = history_count | minus: 1 %}
{% assign forecast_count = daily_count | minus: today_index %}
{% assign forecast_last_offset = forecast_count | minus: 1 %}
{% assign history_points = "" %}
{% assign forecast_points = "" %}

{% for record in daily_records %}
  {% assign fields = record | split: "," %}
  {% if fields[1] != nil and fields[1] != blank %}
    {% assign daily_value = fields[1] | plus: 0 %}
    {% if daily_value >= 0 %}
      {% assign remainder = forloop.index0 | modulo: 2 %}
      {% if forloop.index0 >= today_index or remainder == 0 or forloop.index0 == history_last_index or forloop.index0 == peak_one_index or forloop.index0 == peak_two_index or forloop.index0 == peak_three_index or forloop.index0 == valley_one_index or forloop.index0 == valley_two_index %}
        {% if forloop.index0 < today_index %}
          {% if history_last_index > 0 %}
            {% assign x = forloop.index0 | times: 640 | divided_by: history_last_index | plus: 30 %}
          {% else %}
            {% assign x = 30 %}
          {% endif %}
        {% elsif forecast_last_offset > 0 %}
          {% assign forecast_offset = forloop.index0 | minus: today_index %}
          {% assign x = forecast_offset | times: 60 | divided_by: forecast_last_offset | plus: 670 %}
        {% else %}
          {% assign x = 670 %}
        {% endif %}
        {% assign y = chart_max | minus: daily_value | times: 190 | divided_by: chart_span | plus: 22 %}
        {% capture point %}{{ x }},{{ y }} {% endcapture %}
        {% if forloop.index0 < today_index %}
          {% assign history_points = history_points | append: point %}
        {% else %}
          {% assign forecast_points = forecast_points | append: point %}
        {% endif %}
      {% endif %}
    {% endif %}
  {% endif %}
{% endfor %}

{% assign peak_one_x = 30 %}
{% assign peak_two_x = 30 %}
{% assign peak_three_x = 30 %}
{% if history_last_index > 0 %}
  {% assign peak_one_x = peak_one_index | times: 640 | divided_by: history_last_index | plus: 30 %}
  {% assign peak_two_x = peak_two_index | times: 640 | divided_by: history_last_index | plus: 30 %}
  {% assign peak_three_x = peak_three_index | times: 640 | divided_by: history_last_index | plus: 30 %}
{% endif %}
{% assign valley_one_x = 30 %}
{% assign valley_two_x = 30 %}
{% if history_last_index > 0 %}
  {% assign valley_one_x = valley_one_index | times: 640 | divided_by: history_last_index | plus: 30 %}
  {% assign valley_two_x = valley_two_index | times: 640 | divided_by: history_last_index | plus: 30 %}
{% endif %}
{% assign peak_one_y = chart_max | minus: peak_one_value | times: 190 | divided_by: chart_span | plus: 22 %}
{% assign peak_two_y = chart_max | minus: peak_two_value | times: 190 | divided_by: chart_span | plus: 22 %}
{% assign peak_three_y = chart_max | minus: peak_three_value | times: 190 | divided_by: chart_span | plus: 22 %}
{% assign valley_one_y = chart_max | minus: valley_one_value | times: 190 | divided_by: chart_span | plus: 22 %}
{% assign valley_two_y = chart_max | minus: valley_two_value | times: 190 | divided_by: chart_span | plus: 22 %}
{% assign peak_one_label_y = peak_one_y | minus: 8 %}
{% if peak_one_label_y < 14 %}{% assign peak_one_label_y = peak_one_y | plus: 16 %}{% endif %}
{% assign peak_two_label_y = peak_two_y | plus: 16 %}
{% if peak_two_label_y > 226 %}{% assign peak_two_label_y = peak_two_y | minus: 8 %}{% endif %}
{% assign peak_three_label_y = peak_three_y | minus: 8 %}
{% if peak_three_label_y < 14 %}{% assign peak_three_label_y = peak_three_y | plus: 16 %}{% endif %}
{% assign valley_one_label_y = valley_one_y | plus: 16 %}
{% if valley_one_label_y > 226 %}{% assign valley_one_label_y = valley_one_y | minus: 8 %}{% endif %}
{% assign valley_two_label_y = valley_two_y | plus: 16 %}
{% if valley_two_label_y > 226 %}{% assign valley_two_label_y = valley_two_y | minus: 8 %}{% endif %}

<div class="view view--full air-quality-history">
  <style>
    .air-quality-history { box-sizing: border-box; color: #111; display: grid; gap: 32px; grid-template-columns: 170px 1fr; height: 100%; padding: 38px 42px; width: 100%; }
    .air-quality-history__current { align-self: center; border-right: 1px solid #d1d1d1; padding: 30px 32px 30px 0; text-align: center; }
    .air-quality-history__title { color: #333; font-size: 15px; font-weight: 700; letter-spacing: .04em; margin-bottom: 12px; }
    .air-quality-history__value { font-size: 84px; font-weight: 400; letter-spacing: -.09em; line-height: .82; }
    .air-quality-history__category { color: #333; font-size: 17px; font-weight: 700; line-height: 1.15; margin-top: 18px; }
    .air-quality-history__chart { align-self: center; min-width: 0; }
    .air-quality-history svg { display: block; height: 280px; overflow: visible; width: 100%; }
    .air-quality-history__history { fill: none; stroke: #111; stroke-linecap: round; stroke-linejoin: round; stroke-width: 3; }
    .air-quality-history__forecast { fill: none; stroke: #666; stroke-dasharray: 4 4; stroke-linecap: round; stroke-linejoin: round; stroke-width: 2; }
    .air-quality-history__forecast-zone { fill: #ededed; }
    .air-quality-history__today { stroke: #999; stroke-dasharray: 2 4; stroke-width: 1; }
    .air-quality-history__peak { fill: #111; }
    .air-quality-history__peak-label { fill: #111; font-size: 12px; font-weight: 900; }
    .air-quality-history__valley { fill: #fff; stroke: #111; stroke-width: 1.5; }
    .air-quality-history__valley-label { fill: #444; font-size: 11px; font-weight: 800; }
  </style>

  <section class="air-quality-history__current">
    <div class="air-quality-history__title">AQI</div>
    <div class="air-quality-history__value">{% if current_available %}{{ current_aqi | round }}{% else %}—{% endif %}</div>
    <div class="air-quality-history__category">{{ category }}</div>
  </section>

  <section class="air-quality-history__chart">
    <svg viewBox="0 0 760 250" role="img">
      {% if has_series and forecast_count > 0 %}<rect class="air-quality-history__forecast-zone" x="670" y="12" width="60" height="210" rx="3" />{% endif %}
      {% if history_points != blank %}<polyline class="air-quality-history__history" points="{{ history_points }}" />{% endif %}
      {% if forecast_points != blank %}<polyline class="air-quality-history__forecast" points="{{ forecast_points }}" />{% endif %}
      {% if has_series and forecast_count > 0 %}<line class="air-quality-history__today" x1="670" y1="12" x2="670" y2="222" />{% endif %}
      {% if peak_one_value >= 0 %}
        <circle class="air-quality-history__peak" cx="{{ peak_one_x }}" cy="{{ peak_one_y }}" r="3.5" />
        <text class="air-quality-history__peak-label" x="{{ peak_one_x | plus: 8 }}" y="{{ peak_one_label_y }}">{{ peak_one_value | round }} · {{ peak_one_date | append: "T12:00" | date: "%b %d" }}</text>
      {% endif %}
      {% if peak_two_value >= 0 %}
        <circle class="air-quality-history__peak" cx="{{ peak_two_x }}" cy="{{ peak_two_y }}" r="3.5" />
        <text class="air-quality-history__peak-label" x="{{ peak_two_x | plus: 8 }}" y="{{ peak_two_label_y }}">{{ peak_two_value | round }} · {{ peak_two_date | append: "T12:00" | date: "%b %d" }}</text>
      {% endif %}
      {% if peak_three_value >= 0 %}
        <circle class="air-quality-history__peak" cx="{{ peak_three_x }}" cy="{{ peak_three_y }}" r="3.5" />
        <text class="air-quality-history__peak-label" x="{{ peak_three_x | minus: 8 }}" y="{{ peak_three_label_y }}" text-anchor="end">{{ peak_three_value | round }} · {{ peak_three_date | append: "T12:00" | date: "%b %d" }}</text>
      {% endif %}
      {% if valley_one_value < 9999 and valley_one_index != peak_one_index and valley_one_index != peak_two_index and valley_one_index != peak_three_index %}
        <circle class="air-quality-history__valley" cx="{{ valley_one_x }}" cy="{{ valley_one_y }}" r="3.5" />
        <text class="air-quality-history__valley-label" x="{{ valley_one_x | plus: 8 }}" y="{{ valley_one_label_y }}">{{ valley_one_value | round }} · {{ valley_one_date | append: "T12:00" | date: "%b %d" }}</text>
      {% endif %}
      {% if valley_two_value < 9999 and valley_two_index != peak_one_index and valley_two_index != peak_two_index and valley_two_index != peak_three_index %}
        <circle class="air-quality-history__valley" cx="{{ valley_two_x }}" cy="{{ valley_two_y }}" r="3.5" />
        <text class="air-quality-history__valley-label" x="{{ valley_two_x | minus: 8 }}" y="{{ valley_two_label_y }}" text-anchor="end">{{ valley_two_value | round }} · {{ valley_two_date | append: "T12:00" | date: "%b %d" }}</text>
      {% endif %}
    </svg>
  </section>
</div>
